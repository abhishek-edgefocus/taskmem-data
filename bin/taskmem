#!/usr/bin/env python3
"""taskmem — AI-native shared task memory (generic, deterministic plumbing).

The brand name is skin-deep and replaceable: the command name comes from how
the script is invoked, and data lives beside the script (<dir>/bin/<name>
manages <dir>/items/) — see README "Renaming the tool". Engine identifiers
are stable and never follow the brand: the "wm-" item-id prefix and the
WM_DIR / WM_AGENT / WM_NO_COMMIT / WM_DEBUG env vars.

Storage:  one markdown file per work item in $WM_DIR/items/,
          flat YAML-subset frontmatter + freeform markdown body.
History:  every mutation is a git commit, authored as the acting agent.
Contract: this tool is deterministic plumbing only (store, query, mutate, link,
          history, notify). All judgment — planning, prioritization, capture —
          belongs to the AI agents described in AGENTS.md.

Output is JSON (JSONL for find/search) so any agent or script can parse it.
"""
import argparse
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

PROG = Path(sys.argv[0]).name or "taskmem"  # brand name, taken from invocation
WM_DIR = Path(os.environ.get(
    "WM_DIR", str(Path(__file__).resolve().parent.parent))).expanduser()
ITEMS = WM_DIR / "items"
ARCHIVE = WM_DIR / "archive"  # closed items moved out of the scanned working set

CORE_ORDER = ["id", "type", "title", "status", "priority", "size", "due",
              "scheduled", "waiting_on", "nudge", "people", "tags", "links",
              "refs", "created", "updated", "source"]
LIST_FIELDS = {"people", "tags", "links", "refs"}
DATE_FIELDS = ("due", "scheduled", "nudge")
PROTECTED = {"id", "created", "updated"}
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
KEY_RE = r"[A-Za-z_][A-Za-z0-9_-]*?"
OPS = "(!=|!~|>=|<=|=|~|<|>)"
ALPHABET = "23456789abcdefghjkmnpqrstuvwxyz"  # no 0/1/l/o/i lookalikes


def die(msg, code=1):
    print(json.dumps({"error": msg}, ensure_ascii=False), file=sys.stderr)
    sys.exit(code)


def agent_name(args=None):
    by = getattr(args, "by", None) if args else None
    return by or os.environ.get("WM_AGENT") or "unknown"


def now_ts():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def now_minute():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%MZ")


def resolve_date(v):
    """Expand `today`, `today+N`, `today-N` (local date) and `now` (UTC)."""
    m = re.fullmatch(r"today([+-]\d+)?", v.strip())
    if m:
        d = datetime.now() + timedelta(days=int(m.group(1) or 0))
        return d.strftime("%Y-%m-%d")
    if v.strip() == "now":
        return now_ts()
    return v


# ---------------------------------------------------------------- frontmatter
# Deliberately a flat YAML subset: string scalars and flat lists of strings.
# Anything richer belongs in the markdown body. See SCHEMA.md.

def unquote(s):
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    return s


def parse_text(text, where="item"):
    text = text.replace("\r\n", "\n")
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        raise ValueError("%s: missing frontmatter open '---'" % where)
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        raise ValueError("%s: missing frontmatter close '---'" % where)
    fm, last_key = {}, None
    for raw in lines[1:end]:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        m = re.match(r"^\s*-\s+(.*)$", raw)
        if m and last_key is not None:  # block-style list item (read-tolerated)
            if not isinstance(fm[last_key], list):
                fm[last_key] = [] if fm[last_key] == "" else [fm[last_key]]
            fm[last_key].append(unquote(m.group(1).strip()))
            continue
        key, sep, val = raw.partition(":")
        if not sep:
            raise ValueError("%s: bad frontmatter line %r" % (where, raw))
        key, val = key.strip(), val.strip()
        if val.startswith("[") and val.endswith("]"):
            inner = val[1:-1].strip()
            fm[key] = [unquote(x.strip()) for x in inner.split(",") if x.strip()] if inner else []
        else:
            fm[key] = unquote(val)
        last_key = key
    body = "\n".join(lines[end + 1:]).strip("\n")
    return fm, body


def emit_scalar(v):
    v = str(v)
    if v != v.strip() or v.startswith(("[", '"', "'")):
        return '"%s"' % v.replace('"', "'")
    return v


def dump_text(fm, body):
    out = ["---"]
    keys = [k for k in CORE_ORDER if k in fm] + [k for k in fm if k not in CORE_ORDER]
    for k in keys:
        v = fm[k]
        if v in (None, "", []):
            continue
        if isinstance(v, list):
            out.append("%s: [%s]" % (k, ", ".join(emit_scalar(x) for x in v)))
        else:
            out.append("%s: %s" % (k, emit_scalar(v)))
    out.append("---")
    text = "\n".join(out) + "\n"
    if body.strip():
        text += "\n" + body.strip("\n") + "\n"
    return text


# ---------------------------------------------------------------- item store

def item_path(id_):
    """Resolve an id to its file; archived items resolve transparently."""
    if not ID_RE.match(id_):
        die("invalid id: %s" % id_)
    p = ITEMS / (id_ + ".md")
    if not p.exists() and (ARCHIVE / (id_ + ".md")).exists():
        return ARCHIVE / (id_ + ".md")
    return p


def load(id_):
    p = item_path(id_)
    if not p.exists():
        die("not found: %s" % id_)
    fm, body = parse_text(p.read_text(encoding="utf-8"), where=id_)
    return fm, body, p


def save(id_, fm, body):
    ITEMS.mkdir(parents=True, exist_ok=True)
    p = item_path(id_)
    tmp = p.with_suffix(".md.tmp")
    tmp.write_text(dump_text(fm, body), encoding="utf-8")
    os.replace(tmp, p)
    return p


def load_all(include_archive=False):
    items = []
    for d in [ITEMS] + ([ARCHIVE] if include_archive else []):
        if not d.is_dir():
            continue
        for p in sorted(d.glob("*.md")):
            try:
                fm, body = parse_text(p.read_text(encoding="utf-8"), where=p.name)
            except ValueError as e:
                print(json.dumps({"warning": str(e)}), file=sys.stderr)
                continue
            fm["body"] = body
            if d is ARCHIVE:
                fm["archived"] = "true"
            items.append(fm)
    return items


def new_id():
    # "wm-" is a stable engine prefix, not the brand — renames never touch data.
    while True:
        id_ = "wm-" + "".join(secrets.choice(ALPHABET) for _ in range(6))
        if not (ITEMS / (id_ + ".md")).exists() and not (ARCHIVE / (id_ + ".md")).exists():
            return id_


def public(item, fields=None, full=False):
    if fields:
        want = ["id"] + [f for f in fields if f != "id"]
        return {k: item.get(k) for k in want}
    return {k: v for k, v in item.items() if k != "body" or full}


def emit(obj):
    print(json.dumps(obj, ensure_ascii=False))


# ---------------------------------------------------------------- git history

def in_repo():
    return (WM_DIR / ".git").exists()


def git(*argv, **kw):
    return subprocess.run(["git", "-C", str(WM_DIR)] + list(argv),
                          capture_output=True, text=True, **kw)


def commit(msg, agent):
    """Auto-commit every mutation; the acting agent is the commit author."""
    if not in_repo() or os.environ.get("WM_NO_COMMIT"):
        return
    env = dict(os.environ,
               GIT_AUTHOR_NAME=agent, GIT_AUTHOR_EMAIL=agent + "@agents.local",
               GIT_COMMITTER_NAME="wm", GIT_COMMITTER_EMAIL="wm@agents.local")
    for attempt in range(3):
        git("add", "-A")
        r = subprocess.run(["git", "-C", str(WM_DIR), "commit", "-q", "-m", msg],
                           capture_output=True, text=True, env=env)
        if r.returncode == 0 or "nothing to commit" in r.stdout + r.stderr:
            return
        time.sleep(0.2 * (attempt + 1))  # likely index.lock contention
    print(json.dumps({"warning": "git commit failed: " + (r.stderr or r.stdout).strip()}),
          file=sys.stderr)


# ---------------------------------------------------------------- assignments
# k=v sets (comma-splits on list fields), k= clears, k+=v / k-=v edit lists.

ASSIGN_RE = re.compile(r"^(%s)(\+=|-=|=)(.*)$" % KEY_RE, re.S)


def apply_assign(fm, assigns):
    for a in assigns:
        m = ASSIGN_RE.match(a)
        if not m:
            die("bad assignment: %r (expected field=value)" % a)
        k, op, v = m.group(1), m.group(2), m.group(3).strip()
        if k in PROTECTED:
            die("field '%s' is managed by %s and cannot be set" % (k, PROG))
        if k in DATE_FIELDS and v:
            v = resolve_date(v)
            try:
                datetime.strptime(v, "%Y-%m-%d")
            except ValueError:
                die("%s must be a real YYYY-MM-DD date (or today/today+N), got %r" % (k, v))
        if op == "=":
            if v == "":
                fm.pop(k, None)
            elif k in LIST_FIELDS:
                fm[k] = [x.strip() for x in v.split(",") if x.strip()]
            else:
                fm[k] = v
        else:
            cur = fm.get(k, [])
            cur = [cur] if isinstance(cur, str) else list(cur)
            if op == "+=" and v and v not in cur:
                cur.append(v)
            if op == "-=" and v in cur:
                cur.remove(v)
            fm[k] = cur
            if not cur:
                fm.pop(k, None)
    return fm


def read_body(arg):
    if arg is None:
        return None
    return sys.stdin.read() if arg == "-" else arg


# ---------------------------------------------------------------- where engine
# Generic filtering: =, != (comma = IN), ~, !~ (substring), <, <=, >, >=
# (numeric when both sides are numbers, else string — ISO dates compare right).
# `null` matches absent/empty. Values today / today±N / now expand to dates.

WHERE_RE = re.compile(r"^(%s)%s(.*)$" % (KEY_RE, OPS), re.S)


def match(item, key, op, raw):
    cur = item.get(key)
    empty = cur in (None, "", [])
    if raw.strip() == "null":
        if op == "=":
            return empty
        if op == "!=":
            return not empty
        return False
    vals = [resolve_date(x) for x in raw.split(",")] if op in ("=", "!=") else [resolve_date(raw)]
    if isinstance(cur, list):
        if op == "=":
            return any(v in cur for v in vals)
        if op == "!=":
            return all(v not in cur for v in vals)
        if op == "~":
            return any(vals[0].lower() in str(x).lower() for x in cur)
        if op == "!~":
            return not any(vals[0].lower() in str(x).lower() for x in cur)
        return False
    if empty:
        return op in ("!=", "!~")
    s = str(cur)
    if op == "=":
        return s in vals
    if op == "!=":
        return s not in vals
    if op == "~":
        return vals[0].lower() in s.lower()
    if op == "!~":
        return vals[0].lower() not in s.lower()
    a, b = s, vals[0]
    try:
        a, b = float(a), float(b)
    except ValueError:
        pass
    return {"<": a < b, "<=": a <= b, ">": a > b, ">=": a >= b}[op]


def apply_where(items, exprs):
    parsed = []
    for e in exprs or []:
        m = WHERE_RE.match(e)
        if not m:
            die("bad where expression: %r" % e)
        parsed.append(m.groups())
    return [it for it in items if all(match(it, k, op, v) for k, op, v in parsed)]


def apply_sort(items, spec):
    for part in reversed(spec.split(",")):
        key, _, direc = part.partition(":")
        key = key.strip()

        def valkey(it, key=key):
            v = it.get(key)
            if isinstance(v, list):
                v = ",".join(str(x) for x in v)
            s = "" if v is None else str(v)
            try:
                return (0, float(s), "")
            except ValueError:
                return (1, 0.0, s.lower())

        items.sort(key=valkey, reverse=(direc.strip() == "desc"))
        items.sort(key=lambda it, key=key: it.get(key) in (None, "", []))  # absent last
    return items


# ------------------------------------------------------------------- commands

def cmd_init(args):
    for d in (ITEMS, WM_DIR / "prompts", WM_DIR / ".logs"):
        d.mkdir(parents=True, exist_ok=True)
    fresh = not in_repo()
    if fresh:
        git("init", "-q")
    emit({"dir": str(WM_DIR), "git": "initialized" if fresh else "already a repo"})


def cmd_new(args):
    id_ = new_id()
    fm = {"id": id_, "type": args.type, "title": args.title, "status": "open",
          "created": now_ts(), "updated": now_ts(), "source": agent_name(args)}
    apply_assign(fm, args.assign)
    fm["id"], fm["created"] = id_, fm["created"]
    body = read_body(args.body) or ""
    p = save(id_, fm, body)
    commit("new %s: %s" % (id_, fm.get("title", "")), agent_name(args))
    emit(dict(fm, body=body, path=str(p)))


def cmd_get(args):
    for id_ in args.id:
        fm, body, p = load(id_)
        if args.raw:
            sys.stdout.write(p.read_text(encoding="utf-8"))
        else:
            emit(dict(fm, body=body, path=str(p)))


def cmd_set(args):
    if not args.assign and args.body is None:
        die("nothing to do: pass field=value assignments and/or --body")
    fm, body, _ = load(args.id)
    apply_assign(fm, args.assign)
    if args.body is not None:
        body = read_body(args.body)
    fm["updated"] = now_ts()
    p = save(args.id, fm, body)
    commit("set %s: %s" % (args.id, " ".join(args.assign) or "body"), agent_name(args))
    emit(dict(fm, body=body, path=str(p)))


def cmd_log(args):
    fm, body, _ = load(args.id)
    line = "- %s [%s] %s" % (now_minute(), agent_name(args), args.message)
    if "## Log" not in body:
        body = (body.rstrip("\n") + "\n\n## Log" if body.strip() else "## Log")
    body = body.rstrip("\n") + "\n" + line
    fm["updated"] = now_ts()
    save(args.id, fm, body)
    commit("log %s: %s" % (args.id, args.message), agent_name(args))
    emit({"id": args.id, "logged": line})


def cmd_link(args):
    fm, body, _ = load(args.a)
    load(args.b)  # validate target exists
    edge = "%s:%s" % (args.rel, args.b)
    links = fm.get("links", [])
    links = [links] if isinstance(links, str) else list(links)
    if edge not in links:
        links.append(edge)
    fm["links"], fm["updated"] = links, now_ts()
    save(args.a, fm, body)
    commit("link %s %s %s" % (args.a, args.rel, args.b), agent_name(args))
    emit({"id": args.a, "links": links})


def cmd_unlink(args):
    fm, body, _ = load(args.a)
    edge = "%s:%s" % (args.rel, args.b)
    links = [x for x in fm.get("links", []) if x != edge]
    fm["links"], fm["updated"] = links, now_ts()
    if not links:
        fm.pop("links", None)
    save(args.a, fm, body)
    commit("unlink %s %s %s" % (args.a, args.rel, args.b), agent_name(args))
    emit({"id": args.a, "links": links})


def cmd_links(args):
    """Outbound edges from the item's own frontmatter; inbound derived by scan."""
    fm, _, _ = load(args.id)
    all_items = {it["id"]: it for it in load_all(True) if it.get("id")}

    def describe(other_id):
        o = all_items.get(other_id)
        if not o:
            return {"id": other_id, "missing": True}
        d = {"id": other_id, "title": o.get("title"), "status": o.get("status")}
        if o.get("archived"):
            d["archived"] = o["archived"]
        return d

    out = []
    for edge in fm.get("links", []):
        rel, _, target = edge.partition(":")
        out.append(dict({"rel": rel}, **describe(target)))
    inbound = []
    for it in all_items.values():
        for edge in it.get("links", []) if isinstance(it.get("links"), list) else []:
            rel, _, target = edge.partition(":")
            if target == args.id:
                d = {"rel": rel, "id": it["id"],
                     "title": it.get("title"), "status": it.get("status")}
                if it.get("archived"):
                    d["archived"] = it["archived"]
                inbound.append(d)
    emit({"id": args.id, "out": out, "in": inbound})


LINEAGE = ("parent", "follows")


def thread_nodes(focus, all_rels=False):
    """Transitive parent/follows lineage around `focus`, both directions
    (every rel when all_rels), archived members included."""
    items = {it["id"]: it for it in load_all(True) if it.get("id")}
    up, down = {}, {}
    for it in items.values():
        links = it.get("links") or []
        for edge in (links if isinstance(links, list) else [links]):
            rel, _, target = edge.partition(":")
            if not all_rels and rel not in LINEAGE:
                continue
            up.setdefault(it["id"], []).append((rel, target))
            down.setdefault(target, []).append((rel, it["id"]))
    roots, seen, stack = [], set(), [focus]
    while stack:
        cur = stack.pop()
        if cur in seen:
            continue
        seen.add(cur)
        parents = [t for _, t in up.get(cur, []) if t in items]
        if not parents:
            roots.append(cur)
        stack.extend(parents)
    out, visited = [], set()

    def walk(id_, depth, rel):
        if id_ in visited:
            return
        visited.add(id_)
        it = items.get(id_, {})
        node = {"id": id_, "depth": depth, "rel": rel, "focus": id_ == focus,
                "status": it.get("status"), "title": it.get("title")}
        for k in ("priority", "size", "due"):
            if it.get(k):
                node[k] = it[k]
        if it.get("archived"):
            node["archived"] = it["archived"]
        if not it:
            node["missing"] = True
        out.append(node)
        for r, child in sorted(down.get(id_, [])):
            walk(child, depth + 1, r)

    for r in sorted(set(roots)):
        walk(r, 0, None)
    return out


def cmd_thread(args):
    load(args.id)  # validate focus exists
    for n in thread_nodes(args.id, args.all):
        if args.oneline:
            rel = n.get("rel")
            prefix = "" if rel in (None, "parent") else \
                ("↩ " if rel == "follows" else "(%s) " % rel)
            print("%s%s%s [%s] %s%s%s" % ("   " * n["depth"], prefix, n["id"],
                                          n.get("status", "?"), n.get("title", ""),
                                          " (due %s)" % n["due"] if n.get("due") else "",
                                          "  ◀ focus" if n["focus"] else ""))
        else:
            emit(n)


def cmd_story(args):
    """Everything about one item: fields, context, lineage, and a merged
    chronological timeline of git mutations + semantic ## Log lines."""
    fm, body, p = load(args.id)
    context = body.split("## Log")[0].strip()
    events = []
    logsec = body.split("## Log", 1)[1] if "## Log" in body else ""
    for line in logsec.splitlines():
        m = re.match(r"^- (\S+) \[([^\]]*)\] (.*)$", line.strip())
        if m:
            events.append({"time": m.group(1), "by": m.group(2),
                           "event": m.group(3), "src": "log"})
    if in_repo():
        rel = str(item_path(args.id).relative_to(WM_DIR))
        r = git("log", "--follow", "--format=%aI\t%an\t%s", "--", rel)
        for ln in r.stdout.strip().splitlines():
            t, an, s = ln.split("\t", 2)
            if s.startswith("log %s:" % args.id):
                continue  # its semantic ## Log line is already in the timeline
            events.append({"time": t, "by": an, "event": s, "src": "git"})

    def when(e):
        try:
            return datetime.fromisoformat(e["time"].replace("Z", "+00:00"))
        except ValueError:
            return datetime.min.replace(tzinfo=timezone.utc)

    events.sort(key=when)
    nodes = thread_nodes(args.id)
    if not args.oneline:
        emit(dict(fm, context=context, thread=nodes, timeline=events, path=str(p)))
        return
    print("%s [%s] %s" % (fm.get("id"), fm.get("status"), fm.get("title")))
    meta = []
    for k in ("type", "priority", "size", "due", "scheduled", "waiting_on",
              "nudge", "people", "tags", "refs", "source"):
        v = fm.get(k)
        if v:
            meta.append("%s=%s" % (k, ",".join(v) if isinstance(v, list) else v))
    if meta:
        print("  " + "  ".join(meta))
    if context:
        print("\n" + context)
    if len(nodes) > 1:
        print("\n── Thread ──")
        for n in nodes:
            print("%s%s [%s] %s%s" % ("   " * n["depth"], n["id"], n.get("status", "?"),
                                      n.get("title", ""), "  ◀" if n["focus"] else ""))
    print("\n── Timeline ──")
    for e in events:
        print("%-25s %-14s %s" % (e["time"], e["by"], e["event"]))


def cmd_delegate(args):
    """Render a copy-paste prompt that hands this item to any AI agent:
    inline context (self-contained) + pointers to the underlying item."""
    fm, body, p = load(args.id)
    context = body.split("## Log")[0].strip()
    pri = {"p0": "urgent", "p1": "high", "p2": "", "p3": "low"}.get(
        fm.get("priority", ""), fm.get("priority", ""))
    size = {"xs": "~15 min", "s": "under an hour", "m": "half a day",
            "l": "about a day", "xl": "multi-day"}.get(fm.get("size", ""), fm.get("size", ""))
    user = "the user"
    conf = WM_DIR / "config.env"
    if conf.exists():
        for ln in conf.read_text(encoding="utf-8").splitlines():
            if ln.startswith("USER_NAME=") and ln.split("=", 1)[1].strip():
                user = ln.split("=", 1)[1].strip()
    people = fm.get("people")
    facts = [x for x in (
        "status: %s" % fm.get("status", "?"),
        ("priority: %s" % pri) if pri else "",
        ("effort: %s" % size) if size else "",
        ("due: %s" % fm["due"]) if fm.get("due") else "",
        ("scheduled: %s" % fm["scheduled"]) if fm.get("scheduled") else "",
        ("people: %s" % ", ".join(people)) if isinstance(people, list) and people else "",
    ) if x]
    out = ["You are being delegated a work item from %s's shared task memory." % user, "",
           "# %s — %s" % (fm["id"], fm.get("title", ""))]
    if facts:
        out.append("(%s)" % " · ".join(facts))
    out.append("")
    if context:
        out += [context, ""]
    refs = fm.get("refs") or []
    if refs:
        out.append("## References")
        for r in (refs if isinstance(refs, list) else [refs]):
            label, _, url = r.partition("=")
            out.append("- %s: %s" % (label, url or label))
        out.append("")
    nodes = thread_nodes(args.id)
    if len(nodes) > 1:
        out.append("## Where this sits (lineage)")
        for n in nodes:
            out.append("%s- %s [%s] %s%s" % ("  " * n["depth"], n["id"], n.get("status", "?"),
                                             n.get("title", ""),
                                             "  ← this item" if n["focus"] else ""))
        out.append("")
    out += [
        "## The underlying item (source of truth)",
        "- id: %s · file: %s" % (fm["id"], p),
        "- Full record: `%s get %s --raw` · history: `%s story %s --oneline` · "
        "lineage: `%s thread %s --oneline`" % (PROG, fm["id"], PROG, fm["id"], PROG, fm["id"]),
        "- CLI: %s/bin/%s · protocol: %s/AGENTS.md · data model: %s/SCHEMA.md"
        % (WM_DIR, PROG, WM_DIR, WM_DIR),
        "",
        "## Working agreement (if you can access this memory)",
        "1. Identify yourself: export WM_AGENT=<your-role> (or pass --by on every mutation).",
        "2. Read the full item first (`%s get %s --raw`), then mark it active:"
        " `%s set %s status=active`." % (PROG, fm["id"], PROG, fm["id"]),
        "3. Log material findings and decisions as you go: `%s log %s \"...\"`." % (PROG, fm["id"]),
        "4. Capture work you discover as NEW items with status=inbox, linked to this one.",
        "5. Finish: `%s set %s status=done` plus a log line stating the outcome." % (PROG, fm["id"]),
        "   Blocked instead: status=waiting waiting_on=<who> nudge=<date>, log what you await.",
        "6. End with `%s sync` (a safe no-op when no remote is configured)." % PROG,
        "",
        "If you CANNOT access this memory (different machine, no filesystem), work from the "
        "context above and report your outcome back to %s so their agents can record it." % user,
    ]
    print("\n".join(out))


def cmd_find(args):
    items = apply_where(load_all(args.archived), args.where)
    if args.count:
        emit({"count": len(items)})
        return
    apply_sort(items, args.sort)
    if args.offset:
        items = items[args.offset:]
    if args.limit is not None:
        items = items[:args.limit]
    fields = [f.strip() for f in args.fields.split(",")] if args.fields else None
    for it in items:
        if args.oneline:
            due = " due:%s" % it["due"] if it.get("due") else ""
            print("%s  [%s] %s%s" % (it.get("id"), it.get("status", "?"), it.get("title", ""), due))
        else:
            emit(public(it, fields=fields, full=args.full))


def cmd_search(args):
    tokens = [t.lower() for t in " ".join(args.query).split()]
    if not tokens:
        die("empty query")
    results = []
    for it in load_all(args.archived):
        title = str(it.get("title", "")).lower()
        tags = " ".join(it.get("tags", []) if isinstance(it.get("tags"), list) else []).lower()
        hay = json.dumps(it, ensure_ascii=False).lower()
        if not all(t in hay for t in tokens):
            continue
        score = sum(5 * title.count(t) + 3 * tags.count(t) + hay.count(t) for t in tokens)
        body = it.get("body", "").lower()
        pos = min((body.find(t) for t in tokens if t in body), default=-1)
        snippet = ""
        if pos >= 0:
            snippet = " ".join(it["body"][max(0, pos - 60):pos + 90].split())
        results.append((score, {"id": it.get("id"), "title": it.get("title"),
                                "status": it.get("status"), "type": it.get("type"),
                                "score": score, "snippet": snippet}))
    results.sort(key=lambda r: -r[0])
    for _, r in results[:args.limit]:
        emit(r)


def cmd_history(args):
    if not in_repo():
        die("history requires the memory dir to be a git repo (run: %s init)" % PROG)
    rel = str(item_path(args.id).relative_to(WM_DIR))
    if args.diff:
        subprocess.run(["git", "-C", str(WM_DIR), "log", "-p", "--follow",
                        "-n", str(args.limit), "--", rel])
        return
    r = git("log", "--follow", "-n", str(args.limit),
            "--format=%h%x09%aI%x09%an%x09%s", "--", rel)
    for line in r.stdout.strip().splitlines():
        h, date, author, subject = line.split("\t", 3)
        emit({"commit": h, "date": date, "agent": author, "message": subject})


def cmd_rm(args):
    for id_ in args.id:
        _, _, p = load(id_)
        p.unlink()
        commit("rm %s" % id_, agent_name(args))
        emit({"deleted": id_})


def cmd_archive(args):
    """Move items out of the scanned working set. When to archive is agent
    policy (AGENTS.md); this is only the deterministic move."""
    ARCHIVE.mkdir(parents=True, exist_ok=True)
    for id_ in args.id:
        _, _, p = load(id_)
        if p.parent == ARCHIVE:
            emit({"id": id_, "archived": True, "note": "already archived"})
            continue
        p.rename(ARCHIVE / p.name)
        commit("archive %s" % id_, agent_name(args))
        emit({"id": id_, "archived": True})


def cmd_unarchive(args):
    ITEMS.mkdir(parents=True, exist_ok=True)
    for id_ in args.id:
        _, _, p = load(id_)
        if p.parent != ARCHIVE:
            emit({"id": id_, "archived": False, "note": "not archived"})
            continue
        p.rename(ITEMS / p.name)
        commit("unarchive %s" % id_, agent_name(args))
        emit({"id": id_, "archived": False})


def cmd_notify(args):
    if sys.platform == "darwin" and shutil.which("osascript"):
        script = "display notification %s with title %s" % (
            json.dumps(args.message), json.dumps(args.title))
        subprocess.run(["osascript", "-e", script], capture_output=True)
        emit({"notified": args.title, "via": "osascript"})
    elif shutil.which("notify-send"):
        subprocess.run(["notify-send", args.title, args.message], capture_output=True)
        emit({"notified": args.title, "via": "notify-send"})
    else:
        print("NOTIFY: %s — %s" % (args.title, args.message))


def cmd_sync(args):
    commit("wm sync", agent_name(args))
    if not in_repo():
        die("not a git repo (run: %s init)" % PROG)
    remotes = git("remote").stdout.split()
    if not remotes:
        emit({"synced": False, "note": "no git remote configured; local history only"})
        return
    branch = git("branch", "--show-current").stdout.strip() or "main"
    pull = git("pull", "--rebase", "-q", remotes[0], branch)
    if pull.returncode and "couldn't find remote ref" not in pull.stderr:
        git("rebase", "--abort")  # leave the repo clean, never mid-rebase
        die("sync pull failed (conflict? resolve in %s, then sync again): %s"
            % (WM_DIR, (pull.stderr or pull.stdout).strip()))
    push = git("push", "-q", remotes[0], "HEAD")
    if push.returncode:
        die("sync push failed: %s" % (push.stderr or push.stdout).strip())
    emit({"synced": True, "remote": remotes[0], "branch": branch})


# ----------------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog=PROG, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("init", help="create dirs and git repo").set_defaults(fn=cmd_init)

    p = sub.add_parser("new", help="create an item: wm new <type> <title> [field=value ...]")
    p.add_argument("type"); p.add_argument("title"); p.add_argument("assign", nargs="*")
    p.add_argument("--body", help="markdown body ('-' reads stdin)")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("get", help="print item(s) as JSON")
    p.add_argument("id", nargs="+"); p.add_argument("--raw", action="store_true")
    p.set_defaults(fn=cmd_get)

    p = sub.add_parser("set", help="update fields: wm set <id> k=v k+=v k-=v [--body ...]")
    p.add_argument("id"); p.add_argument("assign", nargs="*")
    p.add_argument("--body", help="replace body ('-' reads stdin)")
    p.set_defaults(fn=cmd_set)

    p = sub.add_parser("log", help="append a timestamped line to the item's ## Log")
    p.add_argument("id"); p.add_argument("message")
    p.set_defaults(fn=cmd_log)

    p = sub.add_parser("link", help="add directed edge: wm link <id> <rel> <id>")
    p.add_argument("a"); p.add_argument("rel"); p.add_argument("b")
    p.set_defaults(fn=cmd_link)

    p = sub.add_parser("unlink", help="remove edge: wm unlink <id> <rel> <id>")
    p.add_argument("a"); p.add_argument("rel"); p.add_argument("b")
    p.set_defaults(fn=cmd_unlink)

    p = sub.add_parser("links", help="show outbound and inbound edges for an item")
    p.add_argument("id")
    p.set_defaults(fn=cmd_links)

    p = sub.add_parser("thread", help="show the whole parent/follows lineage an item belongs to")
    p.add_argument("id")
    p.add_argument("--all", action="store_true", help="traverse every rel, not just parent/follows")
    p.add_argument("--oneline", action="store_true", help="render as an indented tree")
    p.set_defaults(fn=cmd_thread)

    p = sub.add_parser("story", help="full context + lineage + merged timeline for one item")
    p.add_argument("id")
    p.add_argument("--oneline", action="store_true", help="human-readable story")
    p.set_defaults(fn=cmd_story)

    p = sub.add_parser("delegate", help="copy-paste prompt to hand this item to any AI agent")
    p.add_argument("id")
    p.set_defaults(fn=cmd_delegate)

    p = sub.add_parser("find", help="query items; repeat --where to AND filters")
    p.add_argument("--where", action="append", metavar="EXPR",
                   help="field OP value; ops: = != ~ !~ < <= > >= ; null; today±N")
    p.add_argument("--sort", default="updated:desc", metavar="k[:desc][,k2...]")
    p.add_argument("--limit", type=int); p.add_argument("--offset", type=int, default=0)
    p.add_argument("--fields", help="comma-separated projection")
    p.add_argument("--full", action="store_true", help="include body")
    p.add_argument("--count", action="store_true")
    p.add_argument("--oneline", action="store_true", help="human-readable lines")
    p.add_argument("--archived", action="store_true", help="include archive/ in the scan")
    p.set_defaults(fn=cmd_find)

    p = sub.add_parser("search", help="full-text search over all items")
    p.add_argument("query", nargs="+"); p.add_argument("--limit", type=int, default=20)
    p.add_argument("--archived", action="store_true", help="include archive/ in the scan")
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("history", help="git history of one item")
    p.add_argument("id"); p.add_argument("--diff", action="store_true")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(fn=cmd_history)

    p = sub.add_parser("rm", help="delete item file(s) (prefer status=dropped)")
    p.add_argument("id", nargs="+")
    p.set_defaults(fn=cmd_rm)

    p = sub.add_parser("archive", help="move item(s) out of the working set into archive/")
    p.add_argument("id", nargs="+")
    p.set_defaults(fn=cmd_archive)

    p = sub.add_parser("unarchive", help="move item(s) back from archive/ into items/")
    p.add_argument("id", nargs="+")
    p.set_defaults(fn=cmd_unarchive)

    p = sub.add_parser("notify", help="OS notification: wm notify <title> <message>")
    p.add_argument("title"); p.add_argument("message")
    p.set_defaults(fn=cmd_notify)

    sub.add_parser("sync", help="commit, then pull --rebase && push if a remote exists")\
       .set_defaults(fn=cmd_sync)

    for name, sp in sub.choices.items():
        if name in ("new", "set", "log", "link", "unlink", "rm", "archive", "unarchive", "sync"):
            sp.add_argument("--by", help="acting agent name (default: $WM_AGENT)")

    args = ap.parse_args()
    try:
        args.fn(args)
    except SystemExit:
        raise
    except Exception as e:
        if os.environ.get("WM_DEBUG"):
            raise
        die("%s: %s" % (type(e).__name__, e))


if __name__ == "__main__":
    main()
