#!/usr/bin/env bash
# Headless review agent for the task memory. USER-TRIGGERED ONLY — cron
# must never call this (user policy: no unattended claude runs); cron only
# reminds the human to run it.
# Usage: agent-brief daily|weekly|intake
# The scheduler decides WHEN an agent wakes; the prompt + AGENTS.md decide
# everything else. Any headless runner works — swap the `claude` line for
# codex/gemini/your own API script without touching anything else.
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
MODE="${1:-daily}"
export WM_AGENT="${MODE}-review"
LOG="$DIR/.logs/${MODE}-$(date +%F).log"
mkdir -p "$DIR/.logs"

"$DIR/bin/taskmem" sync >> "$LOG" 2>&1 || true

PROMPT="$DIR/prompts/${MODE}.md"
[ -f "$PROMPT" ] || PROMPT="$DIR/prompts/${MODE}-review.md"

# Resolve {{PLACEHOLDER}} tokens from config.env (user-specific values live
# there, never in the tracked prompt files).
CONF="$DIR/config.env"
if [ -f "$CONF" ]; then set -a; . "$CONF"; set +a; fi
PROMPT_TEXT="$(python3 - "$PROMPT" <<'PY'
import os, re, sys
text = open(sys.argv[1]).read()
missing = set()
def sub(m):
    v = os.environ.get(m.group(1), "")
    if not v:
        missing.add(m.group(1))
    return v or m.group(0)
out = re.sub(r"\{\{([A-Z_]+)\}\}", sub, text)
if missing:
    sys.stderr.write("WARN: unresolved placeholders (set them in config.env): %s\n"
                     % ", ".join(sorted(missing)))
sys.stdout.write(out)
PY
)"

claude -p "$PROMPT_TEXT" < /dev/null \
  --allowedTools "Bash,Read,ToolSearch,mcp__claude_ai_Linear__list_issues,mcp__claude_ai_Linear__get_issue,mcp__claude_ai_Linear__list_comments,mcp__claude_ai_Slack__slack_send_message,mcp__claude_ai_Slack__slack_search_users,mcp__claude_ai_Slack__slack_search_public_and_private,mcp__claude_ai_Slack__slack_read_thread,mcp__claude_ai_Slack__slack_read_channel" \
  >> "$LOG" 2>&1

"$DIR/bin/taskmem" sync >> "$LOG" 2>&1 || true
find "$DIR/.logs" -name '*.log' -mtime +30 -delete 2>/dev/null || true
