#!/usr/bin/env python3
"""Regenerate DASHBOARD.md — a human-glanceable view of the task memory.

Deterministic rendering of generic queries; no judgment. Agents regenerate it
(daily review, or after batch changes): bin/dashboard. Never edit it by hand.
"""
import json
import os
import subprocess
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
WM_DIR = HERE.parent
TM = str(HERE / "taskmem")
TODAY = datetime.now().strftime("%Y-%m-%d")


def find(*args):
    r = subprocess.run([TM, "find"] + list(args), capture_output=True, text=True, timeout=30)
    return [json.loads(ln) for ln in r.stdout.splitlines() if ln.strip()]


def refs_md(it):
    out = []
    for ref in it.get("refs") or []:
        label, _, url = ref.partition("=")
        out.append("[%s](%s)" % (label, url) if url else label)
    return " ".join(out)


def esc(s):
    return str(s or "").replace("|", "\\|")


def table(items, blocked=False):
    if blocked:
        head = "| id | task | waiting on | nudge | links |\n|---|---|---|---|---|"
        rows = ["| %s | %s | %s | %s | %s |" % (
            it.get("id"), esc(it.get("title")), esc(it.get("waiting_on", "—")),
            ("**%s**" % it["nudge"] if it.get("nudge", "9") <= TODAY else it.get("nudge", "—")),
            refs_md(it)) for it in items]
    else:
        head = "| id | status | pri | size | task | due | links |\n|---|---|---|---|---|---|---|"
        rows = ["| %s | %s | %s | %s | %s | %s | %s |" % (
            it.get("id"), it.get("status"), it.get("priority", ""), it.get("size", ""),
            esc(it.get("title")),
            ("**%s**" % it["due"] if it.get("due", "9") <= TODAY else it.get("due", "")),
            refs_md(it)) for it in items]
    return "\n".join([head] + rows)


def section(out, title, items, blocked=False):
    if items:
        out += ["## %s" % title, "", table(items, blocked), ""]


def main():
    OPEN = ["--where", "status!=done,dropped"]
    out = ["# Task dashboard — %s" % TODAY,
           "", "*Generated by `bin/dashboard` — do not edit by hand.*", ""]
    seen = set()

    def take(items):
        fresh = [it for it in items if it.get("id") not in seen]
        seen.update(it.get("id") for it in fresh)
        return fresh

    section(out, "Due / overdue", take(find(*OPEN, "--where", "due<=today", "--sort", "due")))
    section(out, "Scheduled (today or slipped)",
            take(find(*OPEN, "--where", "scheduled<=today", "--sort", "scheduled")))
    section(out, "In flight", take(find("--where", "status=next,active", "--sort", "updated:desc")))
    section(out, "Replies owed",
            take(find(*OPEN, "--where", "tags=needs-reply", "--sort", "due")))
    section(out, "Blocked / waiting",
            take(find("--where", "status=blocked,waiting", "--sort", "nudge")), blocked=True)
    section(out, "Inbox — needs triage", take(find("--where", "status=inbox", "--sort", "created")))

    projects = find("--where", "type=project", *OPEN, "--sort", "title", "--full")
    if projects:
        out += ["## Projects", ""]
        for p in projects:
            goal = (p.get("body") or "").strip().splitlines()
            goal = goal[0] if goal else ""
            links = refs_md(p)
            out.append("### %s (`%s`)%s" % (p.get("title"), p.get("id"),
                                            " " + links if links else ""))
            if goal:
                out.append("*%s*" % esc(goal))
            kids = find("--where", "links~parent:%s" % p["id"],
                        "--where", "status!=done,dropped", "--sort", "status")
            if kids:
                out.extend("- %s [%s%s] %s%s" % (
                    k.get("id"), k.get("status"),
                    "/" + k["size"] if k.get("size") else "",
                    esc(k.get("title")),
                    " (due %s)" % k["due"] if k.get("due") else "")
                    for k in kids)
            else:
                out.append("- *(no open items — needs a next step)*")
            out.append("")

    upcoming = take(find(*OPEN, "--where", "due>today", "--sort", "due"))
    section(out, "Upcoming (dated)", upcoming)
    backlog = take(find(*OPEN, "--where", "type!=project", "--sort", "priority,updated:desc"))
    section(out, "Backlog (undated)", backlog)
    done = find("--where", "status=done", "--where", "updated>=today-7", "--sort", "updated:desc")
    section(out, "Done this week", done)

    rest = find(*OPEN, "--count")
    out.append("*Working set: %s open items. Full queries: see SCHEMA.md.*"
               % (rest[0]["count"] if rest else "?"))
    (WM_DIR / "DASHBOARD.md").write_text("\n".join(out) + "\n", encoding="utf-8")
    if (WM_DIR / ".git").exists():
        subprocess.run(["git", "-C", str(WM_DIR), "add", "DASHBOARD.md"], capture_output=True)
        subprocess.run(["git", "-C", str(WM_DIR), "commit", "-q", "-m", "dashboard refresh",
                        "--author", "dashboard <dashboard@agents.local>"],
                       capture_output=True,
                       env=dict(os.environ, GIT_COMMITTER_NAME="wm",
                                GIT_COMMITTER_EMAIL="wm@agents.local"))
    print("DASHBOARD.md regenerated")


if __name__ == "__main__":
    main()
