#!/usr/bin/env python3
"""Publish the tool-only files to a second repo (no task data), so colleagues
can clone/pull taskmem without seeing anyone's items.

The data lives in this repo (origin); the tool repo gets a filtered copy —
everything EXCEPT items/, archive/, DASHBOARD.md (and gitignored local files,
which are never committed here anyway). Each publish is an ordinary commit on
top of the tool repo's current tip (a fast-forward), NOT a force-push, so a
colleague's clone always pulls cleanly. It is a no-op when the tool files are
already current, so it is safe to call on every `taskmem sync`.

Usage:
  publish-tool [REMOTE_URL]     # REMOTE_URL defaults to the `tool` git remote
  publish-tool --check          # print whether a publish is needed; change nothing
  publish-tool --reset          # wipe tool-repo history: force-push ONE clean
                                #   orphan commit (use before making it public,
                                #   so no old commit can leak sanitized-away data)

The tool remote is normally the `tool` git remote (git remote add tool <url>).
"""
import os
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
WM_DIR = HERE.parent
DATA_PATHS = ["items", "archive", "DASHBOARD.md"]  # never leaves this repo


def git(*args, **kw):
    return subprocess.run(["git", "-C", str(WM_DIR)] + list(args),
                          capture_output=True, text=True, **kw)


def tool_remote(argv):
    for a in argv:
        if not a.startswith("-"):
            return a
    r = git("remote", "get-url", "tool")
    return r.stdout.strip() if r.returncode == 0 else ""


def build_tool_tree():
    """Tree of HEAD minus the data paths, built from COMMITTED content."""
    idx = tempfile.NamedTemporaryFile(delete=False).name
    try:
        env = dict(os.environ, GIT_INDEX_FILE=idx)
        subprocess.run(["git", "-C", str(WM_DIR), "read-tree", "HEAD"], env=env, check=True,
                       capture_output=True)
        subprocess.run(["git", "-C", str(WM_DIR), "rm", "--cached", "-r", "-q",
                        "--ignore-unmatch"] + DATA_PATHS, env=env, capture_output=True)
        tree = subprocess.run(["git", "-C", str(WM_DIR), "write-tree"], env=env,
                              capture_output=True, text=True, check=True).stdout.strip()
        return tree
    finally:
        try:
            os.unlink(idx)
        except OSError:
            pass


def main():
    argv = sys.argv[1:]
    check_only = "--check" in argv
    reset = "--reset" in argv
    remote = tool_remote([a for a in argv if a not in ("--check", "--reset")])
    if not remote:
        print("no tool remote: add one with `git remote add tool <url>` "
              "or pass the URL", file=sys.stderr)
        return 2

    tree = build_tool_tree()

    # current tool-repo tip + its tree (if the repo has any history yet)
    ls = git("ls-remote", remote, "main")
    if ls.returncode != 0:
        print("cannot reach tool remote: %s" % ls.stderr.strip(), file=sys.stderr)
        return 3
    tip = ls.stdout.split()[0] if ls.stdout.strip() else ""
    parent_args, remote_tree = [], ""
    if tip and not reset:  # --reset ignores history: fresh orphan, no parent
        git("fetch", "-q", remote, "main")
        rt = git("rev-parse", tip + "^{tree}")
        if rt.returncode == 0:
            remote_tree = rt.stdout.strip()
            parent_args = ["-p", tip]

    if tree == remote_tree and not reset:
        print("tool repo already current (%s)" % tip[:9])
        return 0
    if check_only:
        print("publish NEEDED: tool files differ from %s" % (tip[:9] or "(empty repo)"))
        return 0

    head = git("rev-parse", "--short", "HEAD").stdout.strip()
    stamp = datetime.now().strftime("%Y-%m-%d")
    msg = ("taskmem: AI-native shared task memory (tool + docs, no data)"
           if reset else "sync tool to data@%s (%s)" % (head, stamp))
    env = dict(os.environ,
               GIT_AUTHOR_NAME="taskmem-publish", GIT_AUTHOR_EMAIL="publish@agents.local",
               GIT_COMMITTER_NAME="taskmem-publish", GIT_COMMITTER_EMAIL="publish@agents.local")
    commit = subprocess.run(["git", "-C", str(WM_DIR), "commit-tree", tree] + parent_args,
                            input=msg, capture_output=True, text=True, env=env)
    if commit.returncode != 0:
        print("commit-tree failed: %s" % commit.stderr.strip(), file=sys.stderr)
        return 4
    new = commit.stdout.strip()
    # --reset force-pushes a single clean commit (history wipe, one-time before
    # going public); normal mode is a fast-forward, never a force.
    push_args = ["push"] + (["--force"] if reset else []) + [remote, "%s:refs/heads/main" % new]
    push = git(*push_args)
    if push.returncode != 0:
        print("push failed%s: %s" % ("" if reset else " (not force-pushing)",
                                     push.stderr.strip()), file=sys.stderr)
        return 5
    print("%s tool -> %s  (%s)" % ("RESET" if reset else "published", remote, new[:9]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
