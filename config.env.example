# Copy to config.env (or let install.sh create it) and fill in.
# These values are substituted into prompts/*.md at runtime by bin/agent-brief
# wherever {{USER_NAME}} / {{SLACK_USER_ID}} appear — the tracked files stay
# user-agnostic. config.env itself is gitignored.

# How agents refer to you.
USER_NAME=

# Your Slack member id (Slack profile → three dots → Copy member ID).
# Used ONLY as the destination of the review agents' one-DM-per-run brief;
# leave empty to disable Slack DMs entirely.
SLACK_USER_ID=
